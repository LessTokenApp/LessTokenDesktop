# AI Provider Configuration
AI_CLIPBOARD_OPTIMIZER_AI_PROVIDER=claude
AI_CLIPBOARD_OPTIMIZER_CLAUDE_API_KEY=your-anthropic-key
AI_CLIPBOARD_OPTIMIZER_OPENAI_API_KEY=your-openai-key
AI_CLIPBOARD_OPTIMIZER_GEMINI_API_KEY=your-google-key

# Logging
AI_CLIPBOARD_OPTIMIZER_LOG_LEVEL=INFO

# Output Directory
AI_CLIPBOARD_OPTIMIZER_OUTPUT_DIR=/tmp/token-optimizer-outputs

# Flask
FLASK_ENV=production
FLASK_DEBUG=0

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
